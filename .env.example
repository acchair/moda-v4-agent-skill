# Optional URL-citable search backends. Do not commit real credentials.
MODA_SEARCH_PROVIDER=auto
# DuckDuckGo Lite is the public no-key fallback. Set off to use only configured models.
MODA_PUBLIC_SEARCH=auto
DDG_LITE_URL=https://lite.duckduckgo.com/lite/

# Native DeepSeek Web Search, using its Anthropic-compatible server-tool API.
# Keep the actual key only in your local .env.
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_WEB_SEARCH_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=YOUR_API_KEY_HERE

# Native OpenAI Responses web_search. The tool is explicitly requested by code;
# a GPT model will not automatically browse unless this request includes it.
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_WEB_SEARCH_MODEL=gpt-5.5
OPENAI_API_KEY=YOUR_API_KEY_HERE

# Optional explicit Brave source for broad-search pagination.
BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_API_KEY=YOUR_API_KEY_HERE

# Optional generic bridge. It must return real cited URLs; plain chat answers are rejected.
MODA_MODEL_SEARCH_URL=
MODA_MODEL_SEARCH_MODEL=
MODA_MODEL_SEARCH_API_KEY=YOUR_API_KEY_HERE
