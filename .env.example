# Optional web-research backends. Do not commit real credentials or private URLs.
MODA_SEARCH_PROVIDER=auto
# Built-in public DuckDuckGo HTML fallback; set off to require local backends.
MODA_PUBLIC_SEARCH=auto
SEARXNG_URL=http://127.0.0.1:8888
DDG_MCP_URL=http://127.0.0.1:7070/mcp
# Optional public fallbacks. DuckDuckGo Lite is usually more tolerant of
# restricted or slow domestic network paths than the JavaScript-heavy HTML endpoint.
DDG_HTML_URL=https://html.duckduckgo.com/html/
DDG_LITE_URL=https://lite.duckduckgo.com/lite/
# Public Chinese-search fallback. It returns direct result URLs and avoids
# treating a listening but slow MCP port as a usable search backend.
SO360_SEARCH_URL=https://www.so.com/s
# Optional stable paginated broad-search source. When configured it is used
# before public HTML fallbacks; do not commit a real token.
BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_API_KEY=YOUR_API_KEY_HERE

# Optional cited model-search fallback. Plain chat completions without source URLs
# are rejected. Do not commit real API keys.
MODA_MODEL_SEARCH_PROVIDER=auto
# Generic bridge contract: POST {query,max_results,region,model,require_citations}
# and return {results:[{title,url,snippet,date}]}. This can wrap a DeepSeek
# web-search service or another provider that exposes real citations.
MODA_MODEL_SEARCH_URL=
MODA_MODEL_SEARCH_MODEL=
MODA_MODEL_SEARCH_API_KEY=YOUR_API_KEY_HERE

# Native OpenAI Responses web_search fallback.
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_WEB_SEARCH_MODEL=gpt-5.5
OPENAI_API_KEY=YOUR_API_KEY_HERE
